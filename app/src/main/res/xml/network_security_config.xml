<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is enabled so the app can reach user-configured local model
         backends and custom HTTP endpoints, which is core to B Agent's local
         inference support. Remote providers always use HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>